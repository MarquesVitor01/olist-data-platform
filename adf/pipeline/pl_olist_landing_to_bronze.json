{
	"name": "pl_olist_landing_to_bronze",
	"properties": {
		"activities": [
			{
				"name": "gm_listar_arquivos_olist",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_landing_olist_folder",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "flt_apenas_csv",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "gm_listar_arquivos_olist",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('gm_listar_arquivos_olist').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().type, 'File'), endsWith(toLower(item().name), '.csv'))",
						"type": "Expression"
					}
				}
			}
		],
		"annotations": []
	}
}